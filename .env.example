# ---------------------------------------------------------------------------
# Jojuni Technologies — environment variables (local development)
#
# Copy to `.env` and fill in. Vercel gets the same keys via
# Project Settings -> Environment Variables (see DEPLOYMENT.md).
# ---------------------------------------------------------------------------

# Neon (PostgreSQL). Use the POOLED connection string from the Neon dashboard:
#   Console -> your project -> Connect -> "Pooled connection"
# Example:
# DATABASE_URL="postgresql://alex:AbC123@ep-cool-name-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# Optional: the DIRECT (non-pooled) connection string. Migrations prefer this
# when present; pooled works too.
DIRECT_DATABASE_URL=""

# Optional but recommended: protects GET /api/leads (lead export for admins).
# Any long random string, e.g. the output of: openssl rand -hex 24
ADMIN_API_KEY=""

# Optional: port for the local API server (default 3000).
DEV_API_PORT=3000

# -----------------------------------------------------------------------------
# Email (contact form notifications)
# -----------------------------------------------------------------------------
# Submitting "Send project brief" sends two emails via Resend
# (https://resend.com):
#   1. a notification to LEAD_NOTIFY_TO with the full brief
#   2. an acknowledgement to the person who submitted the form
#
# Without RESEND_API_KEY both sends are skipped: the lead is still stored in
# the database, and the visitor is told plainly that no confirmation email
# was sent. Nothing fails silently.

RESEND_API_KEY=""

# Inbox that receives every project brief.
LEAD_NOTIFY_TO="contactform@jojunitechnologies.com.ng"

# Verified sender. Until jojunitechnologies.com.ng is verified in Resend, this
# must stay on Resend's own domain (and deliveries only reach the Resend
# account owner). After verifying the domain, change it to something like:
#   LEAD_FROM_EMAIL="Jojuni Website <forms@jojunitechnologies.com.ng>"
LEAD_FROM_EMAIL="Jojuni Website <onboarding@resend.dev>"
