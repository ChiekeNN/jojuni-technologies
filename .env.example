# ---------------------------------------------------------------------------
# Jojuni Technologies — environment variables (local development)
#
# Copy to `.env` and fill in. Vercel gets the same keys via
# Project Settings -> Environment Variables (see DEPLOYMENT.md).
# ---------------------------------------------------------------------------

# Neon (PostgreSQL). Use the POOLED connection string from the Neon dashboard:
#   Console -> your project -> Connect -> "Pooled connection"
# Example:
# DATABASE_URL="postgresql://alex:AbC123@ep-cool-name-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# Optional: the DIRECT (non-pooled) connection string. Migrations prefer this
# when present; pooled works too.
DIRECT_DATABASE_URL=""

# Optional but recommended: protects GET /api/leads (lead export for admins).
# Any long random string, e.g. the output of: openssl rand -hex 24
ADMIN_API_KEY=""

# Optional: port for the local API server (default 3000).
DEV_API_PORT=3000
